{
  "name": "pokerole-dynamic-sheets",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "description": "Character sheets and a wild-encounter builder for the Pokerole TTRPG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "compare-ui": "sh scripts/compare-ui.sh",
    "verify": "for f in scripts/verify-*.mjs; do echo \"== $f\"; node \"$f\" \"$PWD\" || exit 1; done",
    "deploy": "node scripts/make-deploy.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
