# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*~
.vscode/
.idea/

# The raw dataset and its build scripts live on the dev-data branch, not here.
# Ignored rather than merely absent so a maintainer can drop the folder back in
# place — git archive dev-data | tar -x — without cluttering git status.
app-data/build/

# Release staging, built by tools/make-release.sh on the dev-data branch. It has
# to sit inside the project: gh runs on the host and cannot see the sandbox /tmp.
dist/

# Personal campaign data — keep the sample structure, not real sheets
Trainers and Pokemons/*.json
Trainers and Pokemons/Custom Images/Trainers/*
Trainers and Pokemons/Custom Images/Pokemons/*
Trainers and Pokemons/Wild Pokemons/*

# ...but keep the folder placeholders and the intentional sample image
!Trainers and Pokemons/Custom Images/Trainers/.gitkeep
!Trainers and Pokemons/Wild Pokemons/.gitkeep
!Trainers and Pokemons/Custom Images/Pokemons/My Misdreavus <3 (is a she).png

# Local development notes — machine-specific, not part of the project
CLAUDE.md

# Working notes on the equipment icon picks — kept locally, not shipped
EQUIPMENT-ICONS.md

# Demo recordings for the README, and the GIFs built from them. Hosted outside
# the app download: both release zips are built from git refs, so anything
# committed here would land in every download of the app.
gifs/
